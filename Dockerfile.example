FROM node:22 AS builder

WORKDIR /src

COPY . .
RUN yarn --pure-lockfile install

ENV ROUTER_BASE="/dashboard/" \
    RESOURCE_BASE="/dashboard/"
RUN yarn run build

FROM rancher/rancher:v2.14.3
WORKDIR /var/lib/rancher
RUN rm -rf /usr/share/rancher/ui-dashboard/dashboard*
COPY --from=builder /src/dist /usr/share/rancher/ui-dashboard/dashboard

# ===========================================================================
# Custom Node Driver (docker-machine-driver-harvester v1.0.6) Download & Install
# ===========================================================================
ARG HARVESTER_DRIVER_URL="https://github.com/oshyuni93/docker-machine-driver-harvester/releases/download/v1.0.6/docker-machine-driver-harvester-amd64.tar.gz"

RUN mkdir -p /opt/drivers/management-state/bin /usr/share/rancher/ui/assets && \
    curl -sLf "${HARVESTER_DRIVER_URL}" | tar -xzf - -C /opt/drivers/management-state/bin && \
    chmod +x /opt/drivers/management-state/bin/docker-machine-driver-harvester && \
    ln -sf /opt/drivers/management-state/bin/docker-machine-driver-harvester /usr/share/rancher/ui/assets/docker-machine-driver-harvester
